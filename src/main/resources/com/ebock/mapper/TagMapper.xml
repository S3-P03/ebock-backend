<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ebock.mapper.TagMapper">

    <select id="getAllTags" resultType="com.ebock.business.Tag">
        select *
        from ebock.tag
        WHERE deleted_at IS NULL
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="tag.tagId">
        insert into ebock.tag (name) values (#{tag.name})
    </insert>

    <update id="update">
        update ebock.tag set name = #{tag.name} where tag_id = #{tag.tagId}
    </update>

    <update id="delete">
        update ebock.tag set deleted_at = now() where tag_id = #{tagId}
    </update>

</mapper>
